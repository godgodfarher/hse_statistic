      "source": [
        "import numpy as np, matplotlib.pyplot as plt\n",
        "x = np.random.randn(100)\n",
        "s = np.sort(x)\n",
        "plt.step(s, np.arange(1, len(s)+1)/len(s))\n",
        "plt.show()\n",
        "print(np.quantile(x, .95))"
      ]
